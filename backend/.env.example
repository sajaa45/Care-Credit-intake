# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Run with: uvicorn main:app --reload --env-file .env

# Groq key for screening the free-text answer. Get a free one at https://console.groq.com/keys
# Without it, the call is stubbed: the text isn't screened or flagged, and the screens say a key is needed.
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL=

