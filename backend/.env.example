# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Run with: uvicorn main:app --reload --env-file .env

# Groq key for screening the free-text answer. Get a free one at https://console.groq.com/keys
# Without it, free-text screening fails: the text is deleted and the application is flagged for an employee.
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL=

