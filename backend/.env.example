# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Run with: uvicorn main:app --reload --env-file .env

# Groq key for screening the free-text answer. Without it, free text isn't stored and the application is flagged.
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL=

# Secret for hashing applicant ID numbers. Set once and keep it: changing it unlinks earlier applications.
APPLICANT_ID_KEY=
